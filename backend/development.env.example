# Development Environment Configuration Example
# Copy this to .env and modify as needed

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# AI Model Configuration for Development (Cost-Optimized)
AI_MODEL_DEVELOPMENT=llama-3.1-8b-instant
AI_MODEL_PRODUCTION=llama-3.3-70b-versatile
AI_MAX_TOKENS_DEVELOPMENT=800
AI_MAX_TOKENS_PRODUCTION=1500
AI_ENABLE_FALLBACK=true

# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=propertyai_dev

# JWT Settings
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# AI Services (Optional - will use fallback if not set)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_FACEBOOK_INTEGRATION=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=true

# Development Authentication
ENABLE_MOCK_AUTH_FALLBACK=true
DEVELOPMENT_USER_EMAIL=test@example.com
DEVELOPMENT_USER_PASSWORD=test123
