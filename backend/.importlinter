; Import rules from docs/ARCHITECTURE.md, checked in CI by `lint-imports` (run from backend/).
; `ignore_imports` lists the violations that existed when a rule was introduced (the baseline). The list may only shrink:
; fix an import, then delete its line. A line that no longer matches anything fails the check, so the list cannot go stale.

[importlinter]
root_package = app
exclude_type_checking_imports = True

[importlinter:contract:platform]
name = The platform imports no business code
type = forbidden
source_modules =
    app.platform
forbidden_modules =
    app.modules
    app.api
    app.routers
    app.services
    app.repositories
    app.schemas

[importlinter:contract:modules-no-legacy]
name = New modules never import the old layer
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    app.api
    app.routers
    app.services
    app.repositories
    app.schemas

[importlinter:contract:domains]
name = Domains import only downward (apps > content, conversations > distribution > buyers > inventory > identity)
type = layers
containers =
    app.modules
layers =
    admin : concierge
    newsroom : calendar : showcase : marketing : creative : reels : photoquality : engage : chat : whatsapp : knowledge : notifications
    social
    tracking : interest : report
    listings : ai_listing
    onboarding : waitlist
unmatched_ignore_imports_alerting = error
; Baseline, 2026-10-03. Each line goes away in a MODERNIZATION step:
ignore_imports =
    ; step 5: social builds marketing-pack payloads; content will hand distribution finished posts instead
    app.modules.social.service -> app.modules.marketing.content
    ; step 3: wrong-way dependencies, replaced by callbacks or the owner's query functions
    app.modules.social.service -> app.modules.concierge.attribution
    app.modules.photoquality.router -> app.modules.concierge.config
    app.modules.interest.router -> app.modules.showcase.samples

[importlinter:contract:core-platform]
name = The platform parts of core (config, database, auth, region, brand, indexes, User) import no business code
type = forbidden
source_modules =
    app.core.config
    app.core.database
    app.core.auth_backend
    app.core.region
    app.core.brand
    app.core.indexes
    app.models.user
forbidden_modules =
    app.modules
    app.api
    app.routers
    app.services
    app.repositories
    app.schemas
