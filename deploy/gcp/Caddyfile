(site) {
	encode gzip
	@api path /api/* /docs /openapi.json /uploads/*
	# a deploy recreates the containers (~10-60 s): hold a visitor's request and retry until the container answers again,
	# instead of an instant 502 on every page
	handle @api {
		reverse_proxy backend:8000 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
	handle {
		reverse_proxy frontend:3000 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
}

{$SITE_HOST} {
	import site
}

# Extra names served the same way (for example a new domain while its certificate is being issued). Default: localhost.
{$EXTRA_HOSTS} {
	import site
}

# Other names for the site (www, the old sslip.io address) send visitors to SITE_HOST, keeping the path, so old links in
# posts and messages keep working. REDIRECT_HOSTS is a comma-separated list set in .env.
{$REDIRECT_HOSTS} {
	redir https://{$SITE_HOST}{uri} permanent
}
